# ============================================
# PYTHON (КЭШ И ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ============================================
# SECRETS (КРИТИЧНО! НЕ ПОПАДАЮТ В ОБРАЗ)
# ============================================
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
secrets/
secrets.*
credentials.json
service-account.json

# ============================================
# GIT
# ============================================
.git/
.gitignore
.gitattributes
.gitmodules

# ============================================
# DATABASE DATA (НЕ ДОЛЖНО БЫТЬ В ОБРАЗЕ)
# ============================================
db_data/
pg_data/
*.db
*.sqlite
*.sqlite3
*.sql
!migrations/*.sql
postgres_data/

# ============================================
# LOGS
# ============================================
logs/
*.log
log/
*.pid

# ============================================
# IDE
# ============================================
.vscode/
.idea/
*.swp
*~
.DS_Store
*.sublime-*
.ropeproject/
.mypy_cache/
.ruff_cache/
.pyright/

# ============================================
# OS
# ============================================
Thumbs.db
Desktop.ini
.directory
*.bak

# ============================================
# DOCS (НЕ НУЖНЫ В ОБРАЗЕ)
# ============================================
README.md
README.*
docs/
doc/
*.md
!README.md
CONTRIBUTING.md
LICENSE
LICENSE.txt

# ============================================
# PROJECT SPECIFIC
# ============================================
# Alembic кэш
alembic/__pycache__/
alembic/versions/__pycache__/
alembic/versions/*.pyc

# Uploads (временные файлы, но папку оставляем)
uploads/*.bin
uploads/temp/
uploads/*.tmp
uploads/*.old
!uploads/.gitkeep

# Загруженные файлы (не копируем старые)
media/
staticfiles/

# Poetry (зависимости управляются через requirements.txt)
poetry.lock
pyproject.toml
poetry.toml

# Docker files (не копируем в образ)
docker-compose*.yml
Dockerfile*
.dockerignore
.dockerignore.example

# Тесты (не нужны в production образе)
tests/
test/
*_test.py
test_*.py
pytest.ini
.conftest.py
!tests/conftest.py

# Временные файлы
tmp/
temp/
*.tmp
*.bak
*.orig

# Celery
celerybeat-schedule
celerybeat.pid

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Другое
*.swp
*.swo
*.swn
*.zip
*.tar.gz
*.rar